[init]
    defaultBranch = main

[alias]
    # status and switching
    st = status -s                      # simplify status
    co = checkout                       # switch to another branch
    cb = checkout -b                    # create a new branch and switch to it
    br = branch                         # list all the branches

    # staging and commit
    aa = add -A                         # add all
    cm = commit -m                      # commit with a message
    ca = commit --amend                 # amend last commit
    can = commit --amend --no-edit      # amend last commit without editing the message

    # diff and log
    df = diff                           # show diff between working dir and staged
    dfs = diff --staged                 # show diff between staged and cimmited
    lg = log --graph --oneline --decorate -n 15  # list last 15 commit logs
    lga = log --graph --oneline --decorate --all # list all commit logs

    # undo
    unstage = restore --staged          # unstage
    undo = reset --soft HEAD~1          # cancel last commit but keep the modified files
